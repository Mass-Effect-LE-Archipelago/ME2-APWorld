<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Path to LegendaryExplorerCore.csproj from a LegendaryExplorer checkout; override with -p:LexCoreProject=... -->
    <LexCoreProject Condition="'$(LexCoreProject)' == ''">..\..\..\LegendaryExplorer\LegendaryExplorer\LegendaryExplorerCore\LegendaryExplorerCore.csproj</LexCoreProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(LexCoreProject)" />
  </ItemGroup>
</Project>
